# ==========================================
# FRONTEND CONFIG (Prefix with EXPO_PUBLIC_)
# ==========================================

# Firebase Auth & Web SDK (Used by Expo App)
EXPO_PUBLIC_FIREBASE_API_KEY=your_web_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=votexa-ac15c.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=votexa-ac15c
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=votexa-ac15c.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=419650757228
EXPO_PUBLIC_FIREBASE_APP_ID=your_web_app_id

# Backend API Endpoint
EXPO_PUBLIC_BACKEND_URL=https://votexa-backend-xxxxx-el.a.run.app

# ==========================================
# BACKEND CONFIG
# ==========================================

# Google Cloud
GOOGLE_CLOUD_PROJECT=votexa-ac15c
PORT=8080

# The following secrets are fetched via Secret Manager dynamically
# using getSecret(name). Do NOT set them here in production.
# Only set them locally for testing if Secret Manager is not configured.
# 
# MAPS_API_KEY=
# REDIS_URL=
# GEMINI_API_KEY=
